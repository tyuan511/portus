# SSHield Enterprise server configuration (YAML).
# Copy to <data_dir>/sshield-server.yaml or pass --config/SSHIELD_CONFIG.
# A legacy sshield-server.toml is still discovered as a fallback.
# Every key is optional; values below are the defaults.

server:
  bind: "127.0.0.1:8787"
  # Additional allowed browser origins for cross-origin deployments (default: same-origin only).
  allowed_origins: []
  # Optional built-in TLS (otherwise terminate TLS at your reverse proxy).
  tls_cert: ""
  tls_key: ""

storage:
  # PostgreSQL connection string (sqlc-generated data access layer).
  db_url: "postgres://sshield:sshield@127.0.0.1:5432/sshield?sslmode=disable"
  # Local state that is not database data: vault, server key, bootstrap hint.
  data_dir: "~/.local/share/sshield"
  # Optional JSONL mirror of the audit chain.
  audit_jsonl: ""

vault:
  auto_lock_secs: 900
  # Headless convenience: unlock the vault at startup from a 0600 file.
  # Leave empty to require manual unlock by an admin through the web UI.
  unlock_passphrase_file: ""

bootstrap:
  # Admin account created on first boot (only when no users exist yet).
  admin_username: admin
  admin_password: ""       # empty = generate random, print once + write bootstrap-admin-password.txt
  admin_password_file: ""  # alternatively read the initial password from a 0600 file

security:
  session_idle_minutes: 720   # 12h idle timeout
  session_max_hours: 168      # 7d absolute lifetime
  login_max_attempts: 5       # per-username failures before lockout
  lockout_minutes: 15
  ip_max_attempts: 20         # failures per source IP inside the window
  ip_window_minutes: 60
  enforce_totp: false         # require 2FA enrollment at login
  mcp_rate_per_min: 60        # requests per token per minute on /mcp
  token_ttl_hours: 0          # default API token lifetime (0 = no expiry)
