# Bulwark Enterprise server configuration (YAML).
# Copy to <data_dir>/bulwark-server.yaml or pass -config <path> (or BULWARK_CONFIG).
# A legacy bulwark-server.toml is still discovered as a fallback.
# Every key is optional; values below are the defaults.

server:
  bind: "127.0.0.1:8787"
  # Additional allowed browser origins for cross-origin deployments (default: same-origin only).
  allowed_origins: []
  # Optional built-in TLS (otherwise terminate TLS at your reverse proxy).
  tls_cert: ""
  tls_key: ""

storage:
  # PostgreSQL connection string (sqlc-generated data access layer).
  db_url: "postgres://bulwark:bulwark@127.0.0.1:5432/bulwark?sslmode=disable"
  # Local state that is not database data: server key, bootstrap hint.
  data_dir: "~/.local/share/bulwark"
  # Optional JSONL mirror of the audit chain (extra insurance alongside the DB).
  audit_jsonl: ""

bootstrap:
  # Admin account created on first boot (only when no users exist yet).
  admin_username: admin
  admin_password: ""       # empty = generate random, print once + write bootstrap-admin-password.txt
  admin_password_file: ""  # alternatively read the initial password from a 0600 file

security:
  session_idle_minutes: 720   # 12h idle timeout
  session_max_hours: 168      # 7d absolute lifetime
  login_max_attempts: 5       # per-username failures before lockout
  lockout_minutes: 15
  ip_max_attempts: 20         # failures per source IP inside the window
  ip_window_minutes: 60
  enforce_totp: false         # after login, accounts without enrolled TOTP may only enroll until done
  mcp_rate_per_min: 60        # requests per token per minute on /mcp
  mcp_session_ttl_minutes: 30 # lifetime of each server-issued MCP host session
  token_ttl_hours: 0          # default API token lifetime (0 = no expiry)

terminal:
  enforce: true             # run every submitted interactive line through L1/L2/approval; denied lines never reach the shell
  record: true              # record the full PTY output for replay from the Audit page
  record_max_bytes: 10485760 # cap per session recording (10 MiB); beyond it the recording is truncated

retention:
  mcp_session_days: 0 # prune MCP host-session rows older than N days (0 = keep forever)
  terminal_days: 0    # prune recorded terminal sessions older than N days (0 = keep forever)
  api_token_days: 0   # prune revoked/expired API tokens older than N days (0 = keep forever)

logging:
  file: ""          # additionally mirror logs to a rotating file; empty = stdout only
  max_size_mb: 100  # max size of each rotated log file
  max_backups: 7    # rotated files to retain
  max_age_days: 28  # max age of rotated files

metrics:
  enabled: false # expose GET /metrics in Prometheus text format

notifications:
  webhook_url: "" # JSON POSTs for approval.requested/decided, policy denials, file.uploaded; empty = disabled
  timeout_secs: 5 # per-request webhook POST timeout
